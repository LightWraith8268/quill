# Quill config
# VAULT_PATH: absolute path to your Obsidian vault.
#   Windows: VAULT_PATH=C:\path\to\YourVault
#   macOS / Linux: VAULT_PATH=/Users/you/Documents/YourVault
VAULT_PATH=
DB_PATH=./data/quill.db
# Embedding backend: "voyage" (hosted API, needs a key) or "ollama" (local,
# free, unlimited, no key — best for a long-term no-payment box).
EMBED_PROVIDER=voyage
#
# --- voyage --- one-time 200M free tokens, then paid. Key: https://dashboard.voyageai.com
VOYAGE_API_KEY=
#
# --- ollama (free forever) --- install ollama, pull an embed model, then set
#     EMBED_PROVIDER=ollama + EMBED_MODEL + EMBED_DIM (must equal the model's
#     native dimension; set before the first reindex — changing it later needs
#     a fresh data/quill.db). The Voyage reranker is auto-skipped without a key;
#     hybrid BM25 + vector RRF still applies. Pick by size:
#       all-minilm           384-dim  ~46MB   smallest, fastest (EMBED_DIM=384)
#       snowflake-arctic-embed:xs  384-dim  ~46MB  small, a bit better quality
#       nomic-embed-text     768-dim  ~274MB  best quality (EMBED_DIM=768)
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=voyage-4-lite
RERANK_MODEL=rerank-2.5-lite
EMBED_DIM=1024

# Folder routing (comma-separated globs relative to VAULT_PATH)
STYLE_INCLUDE=Books/**
LORE_INCLUDE=Books/**,Story Ideas/**
UNCENSORED_INCLUDE=Uncensored/**

# Chunking
CHUNK_TOKENS=500
CHUNK_OVERLAP=50

# Voyage rate limits (free tier without payment method = 3 RPM / 10K TPM)
# After adding payment method on dashboard.voyageai.com, raise these:
# Voyage paid tier 1: 2000 RPM / 8M TPM (still free under 200M tokens)
EMBED_RPM=3
EMBED_TPM=10000
EMBED_RETRY_MAX=6

# HTTP (phase 4)
# Generate a token: openssl rand -hex 24
HTTP_PORT=7878
# Bind address. 127.0.0.1 = localhost only (correct behind a cloudflared
# tunnel). Set 0.0.0.0 to expose on the LAN / tailnet directly (keep HTTP_TOKEN
# set if you do).
HTTP_HOST=127.0.0.1
HTTP_TOKEN=

# Workspace + Claude profile
# Top of the writing tree you can open folders from (defaults to VAULT_PATH).
WRITING_ROOT=
# Point the Claude agent at a custom profile dir (its own CLAUDE.md, settings,
# creds) instead of ~/.claude — e.g. a writing-tuned profile. Inherited by the
# spawned Claude CLI from the process env.
CLAUDE_CONFIG_DIR=

# Hybrid retrieval: BM25 (FTS5) + vector with Reciprocal Rank Fusion.
# Set false to fall back to vector-only retrieval.
HYBRID_BM25=true

# Auto-reindex file watcher.
# When true, `quill serve` also starts the file watcher (equivalent to
# `quill serve --watch`). `quill watch` runs the watcher standalone.
QUILL_AUTO_REINDEX=false
# Per-path debounce for the watcher (ms). Editors emit multiple events per save.
WATCH_DEBOUNCE_MS=500

# Usage tracking: token counts and approximate cost recorded per chat turn
# and per Voyage call into the `usage_events` table. Rates are USD per
# million tokens at retail. Voyage charges are accurate (billed by API key);
# Claude/Codex/Gemini figures are APPROXIMATE estimates — those CLIs run
# under your existing subscription / API key. View via `quill usage` or
# GET /api/usage.
